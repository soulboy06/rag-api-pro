# ----------------------------------------------------
# Application Configuration
# ----------------------------------------------------
APP_NAME=rag-api-pro
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=true

# ----------------------------------------------------
# Security & JWT
# ----------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------
# PostgreSQL (Business Fact Source)
# ----------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=rag_pro
DATABASE_URL=postgresql+asyncpg://rag_user:replace-with-a-database-password@127.0.0.1:5432/rag_pro
SYNC_DATABASE_URL=postgresql://rag_user:replace-with-a-database-password@127.0.0.1:5432/rag_pro
POOL_SIZE=20
MAX_OVERFLOW=10
POOL_RECYCLE_SECONDS=3600

# ----------------------------------------------------
# Redis (Task Queue & Lease Coordination)
# ----------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STREAM_NAME=stream:rag_tasks
REDIS_CONSUMER_GROUP=cg:rag_workers

# ----------------------------------------------------
# MinIO Object Storage
# ----------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-minio-password
MINIO_BUCKET_NAME=rag-documents
MINIO_SECURE=false

# ----------------------------------------------------
# Qdrant Vector DB
# ----------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_chunks
VECTOR_DIMENSION=2048

# ----------------------------------------------------
# Memgraph Graph DB
# ----------------------------------------------------
MEMGRAPH_HOST=127.0.0.1
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ----------------------------------------------------
# External LLM & Embedding (Mock by default if empty)
# ----------------------------------------------------
USE_MOCK_MODELS=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.3-flash
EMBEDDING_MODEL=embedding-3

# ----------------------------------------------------
# MinerU v4 Cloud Parser (optional)
# ----------------------------------------------------
MINERU_ENABLED=false
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_KEY=
